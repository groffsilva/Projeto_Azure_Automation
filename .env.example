# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore e nunca deve ser commitado.

# Registro de aplicativo no Entra ID (Azure AD).
# Tenant e Client ID são identificadores, não segredos.
GRAPH_TENANT_ID=f7b7f2e1-1961-45c2-ad04-c07ff7817547
GRAPH_CLIENT_ID=ce552181-823d-46f2-9566-a226ac5273df

# SEGREDO. Nunca versionar, nunca colar em chat ou ticket.
# Em produção, ler do Azure Key Vault em vez de arquivo.
GRAPH_CLIENT_SECRET=

# Caixa onde os contratos chegam.
GRAPH_CAIXA_ENTRADA=gabriel.groff@martinelli.adv.br
